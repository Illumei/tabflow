{
  "manifest_version": 3,
  "name": "TabFlow",
  "version": "1.0.0",
  "description": "Порядок во вкладках без усилий. Поиск, автозакрытие, группировка.",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabFlow"
  },
  "options_page": "options.html",
  "commands": {
    "open-search": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Открыть поиск по вкладкам"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
